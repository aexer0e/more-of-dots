<?xml version="1.0" encoding="utf-8"?>
<!-- The engine restores SkiaSharp from nuget.org even when the machine's NuGet config lists no sources. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
