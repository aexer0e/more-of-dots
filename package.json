{
  "name": "more-of-dots",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "tauri": "tauri",
    "version:config": "node scripts/version.mjs config",
    "version:release-config": "node scripts/version.mjs config --release",
    "check:version": "node --test scripts/version.test.mjs",
    "check:web": "tsc --noEmit",
    "check:replays": "node --test scripts/replay-filters.test.mjs",
    "check": "npm run check:version && npm run check:leaderboard && npm run check:map && npm run check:examples && npm run check:replays && npm run check:player && npm run check:web",
    "build:web": "tsc && vite build",
    "build:site": "node scripts/build-site.mjs",
    "size:audit": "node scripts/size-audit.mjs",
    "build": "node scripts/version.mjs tauri build && npm run size:audit",
    "check:leaderboard": "node --test scripts/leaderboard.test.mjs scripts/leaderboard-chart.test.mjs scripts/leaderboard-activity.test.mjs",
    "check:map": "node --test scripts/map-codec.test.mjs",
    "dev:desktop": "node scripts/version.mjs tauri dev",
    "check:examples": "node --test scripts/dev-data.test.mjs",
    "prepare:player": "node scripts/prepare-player.mjs",
    "check:native": "node scripts/check-native.mjs",
    "check:player": "node --test scripts/player-scheduling.test.mjs scripts/player-sound.test.mjs scripts/player-view.test.mjs scripts/player-frames.test.mjs",
    "installers": "node scripts/download-installers.mjs",
    "check:engine": "cargo test --release --manifest-path engine/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "satori": "^0.12.2",
    "typescript": "^5.8.0",
    "vite": "^8.0.16"
  }
}
