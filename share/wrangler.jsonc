{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wod-replays",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The site's pages, so each link gets its own preview (src/site.js).
  "routes": [{ "pattern": "aexer0e.dev/wod-replay-player*", "zone_name": "aexer0e.dev" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wod-replays",
      "database_id": "6010c506-0044-4029-a9ae-c57c9b424c76",
      "migrations_dir": "migrations"
    }
  ],
  // One room per match continued from a replay (src/match.js).
  "durable_objects": { "bindings": [{ "name": "MATCHES", "class_name": "MatchRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom"] }],
  // Uploads per visitor address.
  "ratelimits": [
    {
      "name": "UPLOADS",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
